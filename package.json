{
  "name": "global-dub-plate",
  "version": "1.0.0",
  "description": "Global Dub Plate - Live Dubplate, Jingle & Drop-In Escrow Platform for Reggae Sound Systems Worldwide",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node test-api.js",
    "build:icon": "node scripts/generate-icon.js",
    "build:dmg": "node scripts/build-dmg.js",
    "electron": "electron electron/main.js",
    "dist:mac": "electron-builder --mac dmg"
  },
  "build": {
    "appId": "com.jahvisions.globaldubplate",
    "productName": "Global Dub Plate",
    "mac": {
      "category": "public.app-category.music",
      "icon": "build/AppIcon.icns",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "title": "Global Dub Plate DAW Installer",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "server.js",
      "electron/**/*",
      "public/**/*",
      "data/**/*",
      "package.json"
    ]
  },
  "keywords": [
    "reggae",
    "sound-system",
    "dubplate",
    "sound-clash",
    "dancehall",
    "stems",
    "split-track",
    "escrow",
    "global-dub-plate"
  ],
  "author": "Adrian Anesu Mupemhi for Jahvisions, Benjamin Music & Terence Taona Technologies",
  "license": "UNLICENSED"
}
